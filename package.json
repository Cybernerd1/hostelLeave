{
  "name": "hostel-leave-management",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade Hostel Leave Management System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "build:types": "npm run build -w packages/shared-types",
    "build:utils": "npm run build -w packages/shared-utils",
    "build:packages": "npm run build:types && npm run build:utils",
    "build:all": "npm run build:packages && npm run build:api && npm run build:web",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "seed": "npm run seed -w apps/api"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "author": "Hostel Leave Management Team",
  "license": "UNLICENSED"
}
